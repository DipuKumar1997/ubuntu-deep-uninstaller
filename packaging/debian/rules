#!/usr/bin/make -f

%:
	dh $@ --buildsystem=cmake

override_dh_auto_configure:
	dh_auto_configure -- -DCMAKE_BUILD_TYPE=RelWithDebInfo

override_dh_auto_test:
	# Run the core test suite as part of the package build; fail the
	# build if any safety/detection test regresses.
	dh_auto_test -- ARGS="--output-on-failure"

override_dh_installsystemd:
	# This package installs no systemd units of its own; explicitly
	# no-op to avoid debhelper guessing at one.
	true
